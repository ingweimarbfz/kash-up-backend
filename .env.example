# Supabase (Project Settings → API). La clave secreta solo vive en el servidor.
SUPABASE_URL=https://hmmwcdoeyrmhyvvxkspj.supabase.co
SUPABASE_SECRET_KEY=
# Cadena larga y aleatoria para firmar las sesiones (p. ej. openssl rand -hex 32)
JWT_SECRET=
PORT=4000
# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:3000
SESSION_HOURS=12

# Enlace a la app en los avisos de Telegram (si no, se usa el primer CORS_ORIGIN https)
PUBLIC_APP_URL=
